<style>
  :root{
    --navy:#122E5C;
    --navy-deep:#0B1E40;
    --teal:#4DC8C8;
    --teal-soft:#DFF6F6;
    --white:#FFFFFF;
    --ink:#0E2444;
    --mist:#F4F8FA;
    --line:rgba(18,46,92,.12);
    --mono:'IBM Plex Mono',monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Nunito',sans-serif;
    color:var(--ink);
    background:var(--mist);
    line-height:1.55;
  }
  h1,h2,h3,.disp{font-family:'Poppins',sans-serif;}
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}

  header{
    position:sticky;top:0;z-index:50;
    background:var(--navy);
    border-bottom:1px solid rgba(255,255,255,.08);
  }
  .nav-wrap{
    max-width:1280px;margin:0 auto;padding:.9rem 1.5rem;
    display:flex;align-items:center;justify-content:space-between;gap:1rem;
  }
  .brand{display:flex;align-items:center;gap:.6rem;color:var(--white);font-weight:800;font-size:1.05rem;letter-spacing:.01em;}
  .brand .dot{width:9px;height:9px;border-radius:50%;background:var(--teal);}
  nav.links{display:flex;gap:1.4rem;flex-wrap:wrap;}
  nav.links a{
    color:rgba(255,255,255,.72);font-size:.82rem;font-weight:600;
    letter-spacing:.03em;text-transform:uppercase;
    padding:.3rem 0;border-bottom:2px solid transparent;
    transition:color .2s, border-color .2s;
  }
  nav.links a:hover{color:var(--teal);border-color:var(--teal);}

  .hero{
    background:linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 62%, #081530 100%);
    color:var(--white);
    position:relative;overflow:hidden;
  }
  .hero::after{
    content:"";position:absolute;right:-12%;top:-25%;width:60%;height:160%;
    background:radial-gradient(circle at center, rgba(77,200,200,.22), transparent 65%);
    pointer-events:none;
  }
  .hero-inner{
    max-width:1280px;margin:0 auto;padding:5rem 1.5rem 3.5rem;
    display:grid;grid-template-columns:1.3fr .9fr;gap:3rem;align-items:end;position:relative;z-index:1;
  }
  .eyebrow{
    font-family:var(--mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;
    color:var(--teal);margin-bottom:1.1rem;
  }
  .hero h1{
    font-size:clamp(2.1rem,4.2vw,3.3rem);font-weight:700;line-height:1.14;letter-spacing:-.01em;
    max-width:16ch;
  }
  .hero p.lead{
    margin-top:1.2rem;color:rgba(255,255,255,.72);font-size:1.02rem;max-width:46ch;
  }
  .stat-panel{
    display:grid;gap:1.1rem;
  }
  .stat{
    border-left:2px solid var(--teal);padding-left:1rem;
  }
  .stat .num{font-family:'Poppins',sans-serif;font-weight:700;font-size:1.6rem;color:var(--white);}
  .stat .cap{font-size:.82rem;color:rgba(255,255,255,.62);margin-top:.1rem;}

  .section{
    max-width:1280px;margin:0 auto;padding:4.2rem 1.5rem 1rem;
  }
  .cat-head{
    display:flex;align-items:baseline;gap:1rem;margin-bottom:2.2rem;
    border-bottom:1px solid var(--line);padding-bottom:1rem;
  }
  .cat-head .tag{
    font-family:var(--mono);font-size:.72rem;color:var(--teal);
    background:var(--navy);padding:.3rem .6rem;border-radius:3px;letter-spacing:.05em;
    white-space:nowrap;
  }
  .cat-head h2{font-size:1.55rem;font-weight:700;color:var(--navy-deep);}
  .cat-note{color:#5B6B85;font-size:.9rem;max-width:60ch;margin:-1.3rem 0 2rem;}

  .grid{
    display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem;
    margin-bottom:1rem;
  }
  .card{
    background:var(--white);border:1px solid var(--line);border-radius:10px;
    padding:1.4rem 1.4rem 1.5rem;display:flex;flex-direction:column;gap:.6rem;
    transition:border-color .2s, transform .2s, box-shadow .2s;
  }
  .card:hover{
    border-color:var(--teal);transform:translateY(-2px);
    box-shadow:0 12px 28px -18px rgba(18,46,92,.35);
  }
  img.pic{
    width:100%;height:132px;object-fit:contain;object-position:center;
    background:var(--white);border-radius:6px;margin-bottom:.2rem;
  }
  .card .name{
    font-family:'Poppins',sans-serif;font-weight:700;font-size:1.05rem;color:var(--navy-deep);
  }
  .card .name sup{font-size:.55em;}
  .card .sub{
    font-size:.82rem;color:var(--teal);font-weight:600;
  }
  .card ul{list-style:none;margin-top:.4rem;display:flex;flex-direction:column;gap:.4rem;}
  .card li{
    font-size:.85rem;color:#41506A;padding-left:1rem;position:relative;
  }
  .card li::before{
    content:"";position:absolute;left:0;top:.5em;width:5px;height:5px;border-radius:50%;
    background:var(--teal);
  }
  .card .spec{
    margin-top:.5rem;padding-top:.6rem;border-top:1px dashed var(--line);
    font-family:var(--mono);font-size:.74rem;color:#5B6B85;line-height:1.7;
  }

  .pack{
    background:var(--white);border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  }
  .pack-inner{
    max-width:1280px;margin:0 auto;padding:3.5rem 1.5rem;
  }
  .pack-inner > .eyebrow{color:var(--navy);}
  .pack-inner h2{font-size:1.5rem;color:var(--navy-deep);max-width:38ch;margin-bottom:2rem;}
  .pack-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;}
  .pack-card{
    background:var(--teal-soft);border-radius:10px;padding:1.3rem 1.4rem;
    display:flex;flex-direction:column;gap:.5rem;
  }
  .pack-card .tag{font-family:var(--mono);font-size:.7rem;color:var(--navy);letter-spacing:.05em;text-transform:uppercase;}
  .pack-card h3{font-size:1.02rem;color:var(--navy-deep);}
  .pack-card p{font-size:.87rem;color:#3A4C68;}

  footer{background:var(--navy-deep);color:rgba(255,255,255,.75);}
  .footer-inner{
    max-width:1280px;margin:0 auto;padding:3rem 1.5rem 2.2rem;
    display:grid;grid-template-columns:1.2fr 1fr;gap:2rem;
  }
  .footer-inner h3{color:var(--white);font-size:1rem;margin-bottom:.6rem;}
  .footer-inner p{font-size:.85rem;line-height:1.7;}
  .footer-inner .brands{display:flex;gap:1.4rem;align-items:center;margin-bottom:1rem;font-family:'Poppins',sans-serif;font-weight:700;color:var(--white);}
  .foot-bottom{
    border-top:1px solid rgba(255,255,255,.08);
    text-align:center;font-size:.76rem;color:rgba(255,255,255,.45);
    padding:1.2rem 1.5rem;font-family:var(--mono);
  }

  @media (max-width:820px){
    .hero-inner{grid-template-columns:1fr;}
    nav.links{display:none;}
    .footer-inner{grid-template-columns:1fr;}
  }
</style>
</head>
